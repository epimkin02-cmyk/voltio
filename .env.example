# Public origin of the deployed site, no trailing slash (canonical URLs, OG tags, sitemap).
NEXT_PUBLIC_SITE_URL=
# Meta Pixel (dataset) id, digits only. Empty = no pixel. Loads only after marketing consent.
NEXT_PUBLIC_META_PIXEL_ID=
# Server-only: where /api/lead forwards every lead (each one that is set).
# The URLs contain access tokens — set them on Vercel, never commit them.
LEADMETRICS_WEBHOOK_URL=
LEADTABLE_WEBHOOK_URL=
UMSATZPILOT_LEADS_WEBHOOK_URL=
