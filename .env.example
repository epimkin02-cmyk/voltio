# Public origin of the deployed site, no trailing slash (canonical URLs, OG tags, sitemap).
NEXT_PUBLIC_SITE_URL=
# Meta Pixel (dataset) id, digits only. Empty = no pixel. Loads only after marketing consent.
NEXT_PUBLIC_META_PIXEL_ID=
# Optional override for the Funnel Builder origin the lead form posts to.
NEXT_PUBLIC_FUNNEL_BUILDER_URL=
# TinaCMS (visual editing). Both from app.tina.io → project → Overview / Tokens.
# Empty = the site reads content/pages/*.json from disk and /admin is unavailable.
NEXT_PUBLIC_TINA_CLIENT_ID=
TINA_TOKEN=
